node_modules
dist
src-tauri/target
# Tauri regenerates the schemas on every build. gen/android is the Android project: keep it
# (its own .gitignore files leave out build output).
src-tauri/gen/schemas
*.log
.DS_Store

# Personal data: playlist exports from Spotify, Google Takeout, phones (see docs/playlist-interchange)
fixtures/

# Per-user tool settings
.claude/settings.local.json

# The updater signing key normally lives in %USERPROFILE%\.tauri; never commit a copy
*.key

# Android release signing keystore (docs/android-design.md §7): lives outside the repo
*.jks
*.keystore
keystore.properties
